def cmd_serve(args):
    from http.server import BaseHTTPRequestHandler, HTTPServer
    from urllib.parse import urlparse, parse_qs
    db = connect(args.db)
    meta = dict(db.execute("SELECT key, value FROM meta"))
    me = meta.get("accountId", "")

    def fmt(ts):
        return datetime.fromtimestamp(ts, timezone.utc).strftime("%Y-%m-%d %H:%M") if ts else "?"

    def tweets_query(p):
        q = (p.get("q") or [""])[0].strip()
        typ = (p.get("type") or ["all"])[0]
        order = "DESC" if (p.get("sort") or ["desc"])[0] == "desc" else "ASC"
        off = max(0, int((p.get("off") or ["0"])[0]))
        lim = min(500, max(1, int((p.get("lim") or ["100"])[0])))
        where, params = [], []
        if typ == "original":
            where.append("t.is_retweet=0 AND t.reply_to_user IS NULL AND t.deleted=0")
        elif typ == "replies":
            where.append("t.reply_to_user IS NOT NULL")
        elif typ == "retweets":
            where.append("t.is_retweet=1")
        elif typ == "deleted":
            where.append("t.deleted=1")
        if q:
            # fts when it parses, plain LIKE when the user types something fts rejects
            try:
                db.execute("SELECT 1 FROM tweets_fts WHERE tweets_fts MATCH ? LIMIT 1", (q,)).fetchone()
                base = ("FROM tweets t JOIN tweets_fts f ON t.rowid=f.rowid "
                        "WHERE tweets_fts MATCH ?")
                params.append(q)
            except sqlite3.OperationalError:
                base = "FROM tweets t WHERE t.text LIKE ?"
                params.append(f"%{q}%")
        else:
            base = "FROM tweets t WHERE 1=1"
        for w in where:
            base += " AND " + w
        total = db.execute("SELECT COUNT(*) " + base, params).fetchone()[0]
        rows = db.execute("SELECT t.* " + base + f" ORDER BY t.ts {order} LIMIT ? OFFSET ?",
                          params + [lim, off]).fetchall()
        return {"total": total, "q": bool(q), "rows": [
            {"id": r["id"], "d": fmt(r["ts"]), "t": html.escape(r["text"] or ""),
             "del": bool(r["deleted"]), "rt": html.escape(r["reply_to_user"] or ""),
             "rtw": bool(r["is_retweet"]), "fav": r["favorites"]} for r in rows]}

    def convs_query():
        rows = db.execute(
            "SELECT conversation id, COUNT(*) n, MIN(ts) a, MAX(ts) b, MAX(is_group) g "
            "FROM dms GROUP BY conversation ORDER BY b DESC").fetchall()
        f = lambda t: datetime.fromtimestamp(t, timezone.utc).date().isoformat() if t else "?"
        return {"n": len(rows), "rows": [
            {"id": r["id"], "n": r["n"], "first": f(r["a"]), "last": f(r["b"]),
             "group": bool(r["g"])} for r in rows]}

    def dms_query(p):
        conv = (p.get("conv") or [""])[0]
        q = (p.get("q") or [""])[0].strip()
        off = max(0, int((p.get("off") or ["0"])[0]))
        lim = min(500, max(1, int((p.get("lim") or ["100"])[0])))
        base, params = "FROM dms d WHERE 1=1", []
        if conv and conv != "null":
            base += " AND d.conversation=?"
            params.append(conv)
        if q:
            base += " AND d.text LIKE ?"
            params.append(f"%{q}%")
        total = db.execute("SELECT COUNT(*) " + base, params).fetchone()[0]
        rows = db.execute("SELECT d.* " + base + " ORDER BY d.ts ASC LIMIT ? OFFSET ?",
                          params + [lim, off]).fetchall()
        return {"total": total, "q": bool(q), "rows": [
            {"d": fmt(r["ts"]), "t": html.escape(r["text"] or ""),
             "mine": r["sender"] == me, "sender": html.escape(r["sender"] or "")}
            for r in rows]}

    def stats_query():
        r = db.execute("SELECT MIN(ts), MAX(ts) FROM tweets WHERE ts IS NOT NULL").fetchone()
        f = lambda t: datetime.fromtimestamp(t, timezone.utc).date().isoformat() if t else "?"
        return {"username": meta.get("username", "?"),
                "tweets": db.execute("SELECT COUNT(*) FROM tweets").fetchone()[0],
                "dms": db.execute("SELECT COUNT(*) FROM dms").fetchone()[0],
                "range": f"{f(r[0])} to {f(r[1])}"}

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def do_GET(self):
            u = urlparse(self.path)
            p = parse_qs(u.query)
            try:
                if u.path == "/":
                    body, ctype = PAGE.encode(), "text/html; charset=utf-8"
                elif u.path == "/api/tweets":
                    body, ctype = json.dumps(tweets_query(p)).encode(), "application/json"
                elif u.path == "/api/convs":
                    body, ctype = json.dumps(convs_query()).encode(), "application/json"
                elif u.path == "/api/dms":
                    body, ctype = json.dumps(dms_query(p)).encode(), "application/json"
                elif u.path == "/api/stats":
                    body, ctype = json.dumps(stats_query()).encode(), "application/json"
                else:
                    self.send_response(404); self.end_headers(); return
            except Exception as e:
                body = json.dumps({"error": str(e), "total": 0, "rows": [], "n": 0}).encode()
                ctype = "application/json"
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    # loopback only. this is your dm archive, it does not belong on a lan.
    srv = HTTPServer(("127.0.0.1", args.port), H)
    print(f"  http://127.0.0.1:{args.port}   (loopback only, ctrl-c to stop)")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\n  stopped")


def main():
    p = argparse.ArgumentParser(prog="roost", description="read an X/Twitter data export")
    p.add_argument("--db", default=DB_DEFAULT)
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("load", help="build the database from a .zip or extracted dir")
    a.add_argument("archive")
    a.add_argument("--force", action="store_true")
    a.set_defaults(fn=cmd_load)

    a = sub.add_parser("stats", help="what is in the database")
    a.set_defaults(fn=cmd_stats)

    a = sub.add_parser("search", help="full text search over tweets")
    a.add_argument("query")
    a.add_argument("--limit", type=int, default=50)
    a.set_defaults(fn=cmd_search)

    a = sub.add_parser("user", help="everything involving a handle")
    a.add_argument("handle")
    a.add_argument("--limit", type=int, default=200)
