def cmd_serve(args):
    from http.server import BaseHTTPRequestHandler, HTTPServer
    from urllib.parse import urlparse, parse_qs
    db = connect(args.db)

    def esc(s):
        return html.escape(s or "")

    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def do_GET(self):
            u = urlparse(self.path)
            if u.path == "/":
                body = PAGE.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
            elif u.path == "/api":
                p = parse_qs(u.query)
                q = (p.get("q") or [""])[0]
                k = (p.get("k") or ["text"])[0]
                try:
                    if k == "user":
                        h = q.lstrip("@").lower()
                        rows = db.execute(
                            "SELECT DISTINCT t.* FROM tweets t LEFT JOIN mentions m ON m.tweet_id=t.id "
                            "WHERE LOWER(t.reply_to_user)=? OR m.handle=? ORDER BY t.ts LIMIT 500",
                            (h, h)).fetchall()
                    elif k == "dm":
                        rows = db.execute(
                            "SELECT d.id, d.ts, d.text, 0 AS deleted, NULL AS reply_to_user "
                            "FROM dms_fts f JOIN dms d ON d.rowid=f.rowid WHERE dms_fts MATCH ? "
                            "ORDER BY d.ts LIMIT 500", (q,)).fetchall()
                    else:
                        rows = db.execute(
                            "SELECT t.* FROM tweets_fts f JOIN tweets t ON t.rowid=f.rowid "
                            "WHERE tweets_fts MATCH ? ORDER BY t.ts LIMIT 500", (q,)).fetchall()
                except sqlite3.OperationalError as e:
                    rows = []
                out = []
                for r in rows:
                    d = datetime.fromtimestamp(r["ts"], timezone.utc).strftime("%Y-%m-%d %H:%M") if r["ts"] else "?"
                    out.append({"id": r["id"], "d": d, "t": esc(r["text"]),
                                "del": bool(r["deleted"]), "rt": esc(r["reply_to_user"])})
                body = json.dumps({"n": len(out), "rows": out}).encode()
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
            else:
                self.send_response(404)
                self.end_headers()
                return
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    # loopback only. this is your dm archive, it does not belong on a lan.
    srv = HTTPServer(("127.0.0.1", args.port), H)
    print(f"  http://127.0.0.1:{args.port}   (loopback only, ctrl-c to stop)")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\n  stopped")


def main():
    p = argparse.ArgumentParser(prog="roost", description="read an X/Twitter data export")
    p.add_argument("--db", default=DB_DEFAULT)
    sub = p.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("load", help="build the database from a .zip or extracted dir")
    a.add_argument("archive")
    a.add_argument("--force", action="store_true")
    a.set_defaults(fn=cmd_load)

    a = sub.add_parser("stats", help="what is in the database")
    a.set_defaults(fn=cmd_stats)

    a = sub.add_parser("search", help="full text search over tweets")
    a.add_argument("query")
    a.add_argument("--limit", type=int, default=50)
    a.set_defaults(fn=cmd_search)

    a = sub.add_parser("user", help="everything involving a handle")
    a.add_argument("handle")
    a.add_argument("--limit", type=int, default=200)
    a.set_defaults(fn=cmd_user)

    a = sub.add_parser("thread", help="walk a tweet up to its root and back down")
    a.add_argument("id")
    a.set_defaults(fn=cmd_thread)

    a = sub.add_parser("serve", help="browse it in a browser, loopback only")
    a.add_argument("--port", type=int, default=8777)
    a.set_defaults(fn=cmd_serve)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
